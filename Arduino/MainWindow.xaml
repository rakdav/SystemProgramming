<Window x:Class="Arduino.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Arduino"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Arduino" Height="450" Width="344">
    <Grid HorizontalAlignment="Left" Width="352">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="373*"/>
            <ColumnDefinition Width="427*"/>
        </Grid.ColumnDefinitions>
        <ComboBox Name="comPort"  HorizontalAlignment="Left" Margin="47,23,0,0" VerticalAlignment="Top" Width="205" Grid.ColumnSpan="2" RenderTransformOrigin="0.5,0.5">
            <sys:String>com1</sys:String>
            <sys:String>com2</sys:String>
            <sys:String>com3</sys:String>
            <sys:String>com4</sys:String>
        </ComboBox>
        <Button Grid.Column="1" Content="Open" HorizontalAlignment="Left" Margin="116,28,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <TextBox x:Name="Message" HorizontalAlignment="Left" Margin="47,80,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="266" Grid.ColumnSpan="2" Height="110"/>
        <TextBlock x:Name="Answer" HorizontalAlignment="Left" Margin="47,283,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="266" Height="110"/>
        <Button Grid.Column="1" Content="Send" HorizontalAlignment="Left" Margin="94,217,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.334,-0.652" Width="55"/>

    </Grid>
</Window>
